diff --git a/srcs/bonus/Bot.cpp b/srcs/bonus/Bot.cpp
new file mode 100644
index 0000000..05f9213
--- /dev/null
+++ b/srcs/bonus/Bot.cpp
@@ -0,0 +1,167 @@
+#ifdef BONUS
+
+#include "Bot.hpp"
+
+#include "CTCP.hpp"
+#include "Client.hpp"
+#include "Errors.hpp"
+#include "Reply.hpp"
+#include "Server.hpp"
+#include "TransferManager.hpp"
+#include "Utils.hpp"
+
+#include <sstream>
+
+Bot::Bot() : name_("DCCBot") {}
+
+// ---- Identifiers ------------------------------------------------------------
+
+std::string Bot::getPrefix(const std::string &serverName) const {
+    return name_ + "!bot@" + serverName;
+}
+
+std::string Bot::getVersion(const std::string &serverName) const {
+    return "I am " + name_ + " on " + serverName;
+}
+
+// ---- Command recognition ----------------------------------------------------
+
+/*
+PRIVMSG <target> <cmd>
+
+Targeted to bot (bot command or ctcp)
+	bot <cmd> / #bot <cmd> / dccbot <ctcp>
+Bot command
+	#chan <bot_cmd>
+
+NOTE: Should be called only when params > 1 && !params[0].empty() && !params[1].empty().
+This will intercept any user with nickname bot / BOT / #bot -> but OK for bonus.
+*/
+bool Bot::isForBot(Server                         &server,
+                   const std::vector<std::string> &params) const {
+    const std::string &target = Utils::foldCase(params[0]);
+    if (target == Utils::foldCase(name_) || target == "bot" || target == "#bot")
+        return true;
+    return (server.getChannelManager().isChannelName(params[0]) &&
+            isBotCommand_(params[1]));
+}
+
+bool Bot::isBotCommand_(const std::string &body) const {
+    if (body.empty())
+        return false;
+    std::vector<std::string> words = Utils::split(body, ' ');
+    std::string cmd = Utils::trimPrefix(Utils::foldCase(words[0]), "!");
+    if (cmd.empty())
+        return false;
+
+    static const std::string botCmds[] = {"help", "version", "whoami",
+                                          "send", "accept",  "reject"};
+    static const size_t      totalbotCmds = sizeof(botCmds) / sizeof(*botCmds);
+    for (size_t i = 0; i < totalbotCmds; i++) {
+        if (botCmds[i] == cmd)
+            return true;
+    }
+    return false;
+}
+
+// ---- Command handlers -------------------------------------------------------
+
+// bot <bot_cmd>
+// #chan <bot_cmd>
+void Bot::handleMessage(Server &server, Client &client,
+                        const std::string &body) const {
+    std::vector<std::string> words = Utils::split(body, ' ');
+    std::string cmd = Utils::foldCase(words.empty() ? "" : words[0]);
+    cmd = Utils::trimPrefix(cmd, "!");
+    std::string msg;
+    if (cmd.empty() || cmd == "help")
+        msg = help();
+    else if (cmd == "version")
+        msg = getVersion(server.getServerName());
+    else if (cmd == "whoami")
+        msg = "You are " + client.getNick();
+    else if (cmd == "send") {
+        if (words.size() < 3 || words[1].empty() || words[2].empty())
+            client.sendReply(Reply::reply(Reply::ERR_NEEDMOREPARAMS, "SEND"));
+        else
+            handleSend(server, client, words[1], words[2]);
+        return;
+    } else if (cmd == "accept" || cmd == "reject") {
+        bool ok = server.getTransferManager().setOfferStatus(client.getFd(),
+                                                             cmd == "accept");
+        msg = ok ? (cmd == "accept" ? "transfer accepted - connect to receive"
+                                    : "transfer rejected")
+                 : "no pending transfers for you";
+    } else
+        msg = unknown();
+    client.send(Reply::fromClient(getPrefix(server.getServerName()), "PRIVMSG",
+                                  client.getNick(), msg));
+}
+
+/*
+bot !send <nick> <file>
+	bot is initiator, opens a listener,
+	replies buildCTCP("DCC SEND ...") in PRIVMSG to requester
+
+NOTE: DCC receiver connects to the offer IP.
+127.0.0.1 macOS returns broken accepted socket (SO_ERROR=9 / POLLHUP) when a
+process connects to its own LAN IP, which breaks the transfers for same-host
+receivers
+*/
+void Bot::handleSend(Server &server, Client &client, const std::string &nick,
+                     const std::string &filename) const {
+    try {
+        Client          &target = server.getClientManager().at(nick);
+        TransferManager &tm = server.getTransferManager();
+        std::string      err =
+            tm.openOffer(client.getFd(), target.getFd(), filename);
+        if (!err.empty()) {
+            client.send(Reply::fromClient(getPrefix(server.getServerName()),
+                                          "PRIVMSG", client.getNick(), err));
+            return;
+        }
+        Transfer          *t = tm.current();
+        std::ostringstream dcc;
+        dcc << "DCC SEND " << t->filename << " 127.0.0.1 " << t->port << " "
+            << t->filesize;
+        std::string msg = CTCP::buildCTCP(dcc.str());
+        target.send(Reply::fromClient(getPrefix(server.getServerName()),
+                                      "PRIVMSG", target.getNick(), msg));
+        client.send(Reply::fromClient(getPrefix(server.getServerName()),
+                                      "PRIVMSG", client.getNick(),
+                                      "offer sent to " + target.getNick()));
+    } catch (Error &e) {
+        if (e.hasReply())
+            client.sendReply(e.reply());
+    }
+}
+
+void Bot::handleCTCP(const std::string &serverName, Client &client,
+                     const std::string &body) const {
+    std::string              ctcp = CTCP::extractCTCP(body);
+    std::vector<std::string> words = Utils::split(ctcp, ' ');
+    const std::string &text = Utils::foldCase(words.empty() ? "" : words[0]);
+    std::string        msg;
+    if (text == "version")
+        msg = getVersion(serverName);
+    else if (text.compare(0, 4, "ping") == 0)
+        msg = ctcp;
+    else
+        msg = unknown();
+    client.send(Reply::fromClient(getPrefix(serverName), "NOTICE",
+                                  client.getNick(), CTCP::buildCTCP(msg)));
+}
+
+// ---- Response text ----------------------------------------------------------
+
+// should reply "Do you mean xxx" -> like a compiler.
+// make this a bit smarter?
+std::string Bot::unknown() const {
+    return "Unknown command. Try !help";
+}
+
+std::string Bot::help() const {
+    return "Commands: !help, !version, !whoami, !send, !accept, !reject";
+}
+
+#endif
diff --git a/srcs/bonus/TransferManager.cpp b/srcs/bonus/TransferManager.cpp
new file mode 100644
index 0000000..5fc35cf
--- /dev/null
+++ b/srcs/bonus/TransferManager.cpp
@@ -0,0 +1,209 @@
+#ifdef BONUS
+
+#include "TransferManager.hpp"
+
+#include "Client.hpp"
+
+#include <arpa/inet.h>
+#include <cstring>
+#include <ctime>
+#include <fcntl.h>
+#include <fstream>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+static const int    CHUNK_SIZE = 1024;
+static const time_t STALE_TIMEOUT = 60;
+static const int    LISTENER_BACKLOG = 8;
+static const char  *FILES_DIR = "files/";
+
+TransferManager::TransferManager() : active_(false) {}
+
+TransferManager::~TransferManager() {
+    closeFds_();
+}
+
+// ---- Offer lifecycle --------------------------------------------------------
+
+// returns error msg or ""
+std::string TransferManager::openOffer(int clientFd, int targetFd,
+                                       const std::string &filename) {
+    if (active_) {
+        if (!expired())
+            return "bot busy";
+        closeOffer();
+    }
+    if (filename.find('/') != std::string::npos ||
+        filename.find("..") != std::string::npos)
+        return "invalid filename";
+    std::string filepath = std::string(FILES_DIR) + filename;
+    off_t       size = 0;
+    if (!fileSize_(filepath, size))
+        return std::string("file not found under ") + FILES_DIR;
+    current_ = Transfer(clientFd, targetFd, filename, filepath, size);
+    if (!openListener_()) {
+        closeFds_();
+        return "socket error, try again later";
+    }
+    active_ = true;
+    return "";
+}
+
+bool TransferManager::setOfferStatus(int targetFd, bool accept) {
+    if (!active_ || current_.status != Pending || current_.targetFd != targetFd)
+        return false;
+    current_.status = accept ? Accepted : Rejected;
+    if (!accept)
+        closeOffer();
+    return true;
+}
+
+void TransferManager::closeOffer() {
+    closeFds_();
+    active_ = false;
+}
+
+bool TransferManager::expired() const {
+    return active_ && std::time(0) - current_.lastActivity > STALE_TIMEOUT;
+}
+
+// ---- Listener & connection --------------------------------------------------
+
+bool TransferManager::openListener_() {
+    struct sockaddr_in addr;
+    std::memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    addr.sin_port = htons(0); // let OS pick a port
+
+    int fd = ::socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0)
+        return false;
+
+    int opt = 1;
+    if (::setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)) < 0) {
+        ::close(fd);
+        return false;
+    }
+
+    if (::bind(fd, reinterpret_cast<struct sockaddr *>(&addr), sizeof(addr)) <
+        0) {
+        ::close(fd);
+        return false;
+    }
+    if (::listen(fd, LISTENER_BACKLOG) < 0) {
+        ::close(fd);
+        return false;
+    }
+    setNonBlocking_(fd);
+
+    socklen_t len = sizeof(addr);
+    if (::getsockname(fd, reinterpret_cast<struct sockaddr *>(&addr), &len) <
+        0) {
+        ::close(fd);
+        return false;
+    }
+
+    current_.listenerFd = fd;
+    current_.port = ntohs(addr.sin_port);
+    return true;
+}
+
+// accept() receiver's connection
+int TransferManager::getDataFd() {
+    if (!active_ || current_.status != Accepted || current_.listenerFd == -1)
+        return -1;
+    if (current_.dataFd != -1)
+        return current_.dataFd;
+
+    struct sockaddr_in addr;
+    socklen_t          len = sizeof(addr);
+    int                fd = ::accept(current_.listenerFd,
+                                     reinterpret_cast<struct sockaddr *>(&addr), &len);
+    if (fd < 0)
+        return -1;
+    setNonBlocking_(fd);
+    current_.dataFd = fd;
+    return fd;
+}
+
+// ---- Transfer IO ------------------------------------------------------------
+
+// send 1KB
+ssize_t TransferManager::sendChunk() {
+    if (!active_ || current_.status != Accepted || current_.dataFd == -1)
+        return -1;
+
+    std::ifstream f(current_.filepath.c_str(), std::ios::in | std::ios::binary);
+    if (!f.is_open())
+        return -1;
+    f.seekg(current_.offset);
+    char buf[CHUNK_SIZE];
+    f.read(buf, CHUNK_SIZE);
+    std::streamsize n = f.gcount();
+    if (n <= 0)
+        return 0; // EOF
+    ssize_t sent = ::send(current_.dataFd, buf, n, MSG_NOSIGNAL);
+    if (sent <= 0)
+        return 0;
+    current_.lastActivity = std::time(0);
+    current_.offset += sent;
+    return sent;
+}
+
+// ---- State ------------------------------------------------------------------
+
+int TransferManager::getListenerFd() const {
+    return active_ ? current_.listenerFd : -1;
+}
+
+bool TransferManager::isActive() const {
+    return active_;
+}
+
+Transfer *TransferManager::current() {
+    return active_ ? &current_ : 0;
+}
+
+bool TransferManager::ownsFd(int fd) const {
+    return active_ && (fd == current_.listenerFd || fd == current_.dataFd);
+}
+
+bool TransferManager::transferDone() const {
+    return active_ && (current_.status == Accepted &&
+                       current_.offset >= current_.filesize);
+}
+
+// ---- Helpers ----------------------------------------------------------------
+
+void TransferManager::closeFds_() {
+    if (current_.listenerFd != -1) {
+        ::close(current_.listenerFd);
+        current_.listenerFd = -1;
+    }
+    if (current_.dataFd != -1) {
+        ::close(current_.dataFd);
+        current_.dataFd = -1;
+    }
+}
+
+bool TransferManager::fileSize_(const std::string &path, off_t &size) const {
+    std::ifstream f(path.c_str(), std::ios::in | std::ios::binary);
+    if (!f.is_open())
+        return false;
+    f.seekg(0, std::ios::end);
+    std::streamoff p = f.tellg();
+    if (p < 0)
+        return false;
+    size = static_cast<off_t>(p);
+    return true;
+}
+
+void TransferManager::setNonBlocking_(int fd) {
